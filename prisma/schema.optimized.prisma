// Prisma Schema for VA-PC E-commerce Platform
// Database: PostgreSQL
// OPTIMIZED VERSION with composite indexes and VK sync improvements

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics", "tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONTACTED
  CONFIRMED
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum ComponentType {
  CPU
  GPU
  MOTHERBOARD
  RAM
  STORAGE
  PSU
  CASE
  COOLING
}

// ============================================================================
// CONFIGURATOR (LIMITED-CHOICE, MAPPED-TO-BUILDS)
// ============================================================================

enum ConfiguratorTier {
  RTX4070
  RTX4080
  RTX4090
}

enum ConfiguratorCaseModel {
  ROG_X
  NEO_WHITE
  COMPACT_PRO
  DARKLINE
}

enum ConfiguratorOptionKey {
  TIER
  CASE_MODEL
  CASE_COLOR
  SIDE_PANEL
  RGB
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String?
  phone        String?
  role         UserRole      @default(CUSTOMER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  cart         Cart?
  orders       Order[]
  customBuilds CustomBuild[]

  // OPTIMIZATION: email already has @unique, no need for separate index
  // Removed: @@index([email])
  @@index([role])

  // Composite index for admin user lookup
  @@index([role, createdAt])
}

// ============================================================================
// PRODUCT CATALOG
// ============================================================================

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  products    Product[]

  // OPTIMIZATION: slug has @unique, no separate index needed
  // Composite index for active categories with sort order
  @@index([isActive, sortOrder])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  products  Product[]

  // OPTIMIZATION: slug has @unique, no separate index needed
  @@index([isActive])
}

model Product {
  id          String    @id @default(cuid())
  sku         String    @unique
  name        String
  slug        String    @unique
  description String?   @db.Text
  price       Decimal   @db.Decimal(10, 2)
  salePrice   Decimal?  @db.Decimal(10, 2)
  stock       Int       @default(0)
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)

  // VK Market synchronization - MADE UNIQUE to prevent duplicates
  vkItemId    String?   @unique
  vkOwnerId   Int?      // VK group owner ID for sync
  vkSyncedAt  DateTime? // Last successful sync timestamp
  vkRawData   Json?     // Store raw VK data for debugging

  // Specifications stored as JSON
  specs       Json?

  // Search optimization - full text search fields
  searchVector String?  @db.Text  // Denormalized search text

  // Foreign Keys
  categoryId  String
  brandId     String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  prebuiltItems      PrebuiltConfigItem[]
  customBuildItems   CustomBuildItem[]

  // OPTIMIZATION: Removed redundant single indexes, added composite indexes

  // Primary lookup patterns
  @@index([categoryId, isActive, price])  // Category browsing with price sort
  @@index([categoryId, isActive, createdAt])  // Category browsing with date sort
  @@index([brandId, isActive, price])  // Brand browsing with price sort

  // Featured products query
  @@index([isActive, isFeatured, createdAt])

  // Stock management
  @@index([isActive, stock])

  // VK sync optimization - faster lookups during sync
  @@index([vkOwnerId, vkItemId])
  @@index([vkSyncedAt])

  // Price range queries
  @@index([isActive, price])

  // Sale products
  @@index([isActive, salePrice]) // For finding products on sale
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  productId String
  createdAt DateTime @default(now())

  // Relations
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Composite index for fetching sorted images with primary first
  @@index([productId, isPrimary, sortOrder])
}

// ============================================================================
// PREBUILT CONFIGURATIONS
// ============================================================================

model PrebuiltConfig {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  salePrice   Decimal? @db.Decimal(10, 2)
  imageUrl    String?
  isActive    Boolean  @default(true)
  tier        String   // e.g., "budget", "mid-range", "high-end", "enthusiast"
  useCase     String[] // e.g., ["gaming", "streaming", "workstation"]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  items       PrebuiltConfigItem[]
  cartItems   CartItem[]

  // Composite indexes for filtering
  @@index([isActive, tier, price])
  @@index([isActive, price])
}

model PrebuiltConfigItem {
  id            String        @id @default(cuid())
  quantity      Int           @default(1)
  componentType ComponentType

  // Foreign Keys
  prebuiltId    String
  productId     String

  // Relations
  prebuilt      PrebuiltConfig @relation(fields: [prebuiltId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([prebuiltId, componentType])
  @@index([prebuiltId])
  @@index([productId])
}

// ============================================================================
// CUSTOM BUILD CONFIGURATOR
// ============================================================================

model CustomBuild {
  id         String   @id @default(cuid())
  name       String?
  isComplete Boolean  @default(false)
  totalPrice Decimal  @default(0) @db.Decimal(10, 2)

  // Can belong to user or anonymous session
  userId     String?
  sessionId  String?  @unique

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user       User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CustomBuildItem[]
  cartItems  CartItem[]

  // Composite index for user builds
  @@index([userId, createdAt])
  @@index([sessionId])
}

model CustomBuildItem {
  id            String        @id @default(cuid())
  componentType ComponentType

  // Foreign Keys
  customBuildId String
  productId     String

  createdAt     DateTime      @default(now())

  // Relations
  customBuild   CustomBuild   @relation(fields: [customBuildId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([customBuildId, componentType])
  @@index([customBuildId])
  @@index([productId])
}

// ============================================================================
// SHOPPING CART
// ============================================================================

model Cart {
  id        String     @id @default(cuid())

  // Can belong to user or anonymous session
  userId    String?    @unique
  sessionId String?    @unique

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  // Indexes for cart lookup - @unique already creates indexes
}

model CartItem {
  id            String   @id @default(cuid())
  quantity      Int      @default(1)

  // Store price at time of adding (for price comparison)
  priceAtAdd    Decimal? @db.Decimal(10, 2)

  // Foreign Keys
  cartId        String

  // One of these must be set (product, prebuilt, or customBuild)
  productId     String?
  prebuiltId    String?
  customBuildId String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  cart          Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  prebuilt      PrebuiltConfig? @relation(fields: [prebuiltId], references: [id], onDelete: Cascade)
  customBuild   CustomBuild?   @relation(fields: [customBuildId], references: [id], onDelete: Cascade)

  // Composite index for cart item lookup
  @@index([cartId, productId])
  @@index([cartId, prebuiltId])
  @@index([cartId, customBuildId])
}

// ============================================================================
// ORDERS
// ============================================================================

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  status        OrderStatus @default(PENDING)

  // Customer Information (denormalized for order history)
  customerName  String
  customerEmail String
  customerPhone String

  // Pricing
  subtotal      Decimal     @db.Decimal(10, 2)
  discount      Decimal     @default(0) @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)

  // Notes
  notes         String?     @db.Text  // Customer notes
  adminNotes    String?     @db.Text  // Internal admin notes

  // Foreign Keys
  userId        String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  // Composite indexes for common queries
  @@index([status, createdAt])  // Admin order list by status
  @@index([userId, createdAt])  // User order history
  @@index([customerEmail, createdAt])  // Guest order lookup
  @@index([createdAt])  // Date-based reporting
}

model OrderItem {
  id          String   @id @default(cuid())
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)

  // Denormalized product info (for order history)
  productName String
  productSku  String

  // Foreign Keys
  orderId     String
  productId   String?  // Nullable in case product is deleted

  createdAt   DateTime @default(now())

  // Relations
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  status    OrderStatus
  note      String?
  changedBy String?     // Admin user id or system

  // Foreign Keys
  orderId   String

  createdAt DateTime    @default(now())

  // Relations
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Composite index for order status timeline
  @@index([orderId, createdAt])
}

// ============================================================================
// VK SYNC TRACKING
// ============================================================================

model VKSyncLog {
  id           String     @id @default(cuid())
  syncType     String     // "full", "incremental", "single"
  status       SyncStatus @default(PENDING)

  // Sync statistics
  itemsTotal   Int        @default(0)
  itemsSynced  Int        @default(0)
  itemsFailed  Int        @default(0)
  itemsCreated Int        @default(0)
  itemsUpdated Int        @default(0)

  // Error tracking
  errorMessage String?    @db.Text
  errorDetails Json?

  startedAt    DateTime   @default(now())
  completedAt  DateTime?

  @@index([status, startedAt])
  @@index([startedAt])
}

// ============================================================================
// APPLICATION SETTINGS
// ============================================================================

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // @unique already creates index for key
}

// ============================================================================
// CONFIGURATOR TABLES (CANONICAL BUILDS)
// ============================================================================

model ConfiguratorBuildFamily {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants    ConfiguratorBuildVariant[]

  @@index([isActive, updatedAt])
}

model ConfiguratorBuildVariant {
  id              String                 @id @default(cuid())
  slug            String                 @unique
  name            String
  tier            ConfiguratorTier
  caseModel       ConfiguratorCaseModel
  vkProductId     String?
  isActive        Boolean                @default(true)

  defaultSelection Json
  allowedOptions   Json
  preview          Json

  familyId        String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  family          ConfiguratorBuildFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  options         ConfiguratorVariantOption[]

  @@index([familyId, isActive])
  @@index([tier, caseModel])
  @@index([vkProductId])
}

model ConfiguratorOption {
  id          String               @id @default(cuid())
  key         ConfiguratorOptionKey
  value       String
  label       String
  sortOrder   Int                  @default(0)
  isActive    Boolean              @default(true)

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  variants    ConfiguratorVariantOption[]

  @@unique([key, value])
  @@index([key, isActive])
}

model ConfiguratorVariantOption {
  id          String                 @id @default(cuid())
  variantId   String
  optionId    String
  createdAt   DateTime               @default(now())

  variant     ConfiguratorBuildVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  option      ConfiguratorOption       @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionId])
  @@index([variantId])
  @@index([optionId])
}

// ============================================================================
// CACHE TABLE (for database-level caching)
// ============================================================================

model CacheEntry {
  key       String   @id
  value     Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
