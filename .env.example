# VK API Configuration
# ===================
# To get an access token, create a VK app at https://vk.com/apps?act=manage
# and obtain a service token or user token with market access.
#
# For a service token (recommended for server-side):
# 1. Create a Standalone app at https://vk.com/apps?act=manage
# 2. Go to Settings and copy the Service Key
#
# For a user token (if you need user-specific actions):
# 1. Create an app and get the app_id
# 2. Use Implicit Flow to get token: https://dev.vk.com/api/access-token/implicit-flow-user
# 3. Required scope: market

VK_ACCESS_TOKEN=your_vk_access_token_here

# Optional: VK Group ID (negative number for groups, e.g., -123456789)
# If not provided, will be resolved from screen name 'vapcbuild'
# You can find your group ID at: https://regvk.com/id/
# VK_GROUP_ID=-123456789

# Sync API Configuration
# ======================
# API key for protecting the /api/products/sync endpoint
# Generate a secure random string: openssl rand -hex 32
# In development, if not set, the sync endpoint is open
SYNC_API_KEY=your_secure_sync_api_key_here

# Database Configuration
# ======================
# PostgreSQL connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/vapc_db

# Application Configuration
# =========================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
