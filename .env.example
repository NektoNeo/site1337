# ============================================================================
# VA-PC E-commerce Platform - Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your values
# ============================================================================

# VK API Configuration
# ====================
# VK Market integration for syncing products from vk.com/vapcbuild
#
# To get an access token:
# 
# Option 1: Service Token (Recommended for server-side)
#   1. Create a Standalone app at https://vk.com/apps?act=manage
#   2. Go to Settings and copy the "Service Key"
#   3. This token has read-only access to public data
#
# Option 2: User Token (For user-specific actions)
#   1. Create an app and note the app_id
#   2. Use Implicit Flow: https://dev.vk.com/api/access-token/implicit-flow-user
#   3. Required scope: market
#   4. Token format: https://oauth.vk.com/authorize?client_id=APP_ID&display=page&redirect_uri=https://oauth.vk.com/blank.html&scope=market&response_type=token&v=5.199
#
# Note: Tokens expire! Service tokens last longer than user tokens.

VK_ACCESS_TOKEN=your_vk_access_token_here

# VK Group ID (optional)
# ----------------------
# Negative number for groups (e.g., -123456789)
# If not provided, will be resolved from screen name 'vapcbuild'
# Find your group ID at: https://regvk.com/id/
# VK_GROUP_ID=-123456789

# Sync API Configuration
# ======================
# API key for protecting sync endpoints:
# - POST /api/products/sync
# - POST /api/vk/sync
# - GET /api/vk/sync
# - DELETE /api/vk/sync
#
# Generate a secure random string:
#   openssl rand -hex 32
#
# In development, if not set, sync endpoints are open.
# REQUIRED in production!

SYNC_API_KEY=your_secure_sync_api_key_here

# Database Configuration
# ======================
# PostgreSQL connection string for Prisma ORM
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Local development:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/vapc_db
#
# Docker:
#   DATABASE_URL=postgresql://postgres:password@db:5432/vapc_db
#
# Production (use connection pooling):
#   DATABASE_URL=postgresql://user:pass@host:5432/db?pgbouncer=true

DATABASE_URL=postgresql://postgres:password@localhost:5432/vapc_db

# Application Configuration
# =========================

# Public URL of the application (used for SEO, OG tags, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment: development | production | test
NODE_ENV=development

# ============================================================================
# VK API Endpoints Reference
# ============================================================================
# 
# Products API:
#   GET  /api/vk/products          - List products from VK Market
#   GET  /api/vk/products/[id]     - Get single product by ID
#   GET  /api/vk/categories        - List VK Market albums as categories
#
# Sync API (requires X-API-Key header):
#   GET    /api/vk/sync            - Get sync status and cache stats
#   POST   /api/vk/sync            - Trigger VK to DB sync
#   DELETE /api/vk/sync            - Clear VK API cache
#
# Query Parameters for /api/vk/products:
#   - page: number (default: 1)
#   - pageSize: number (default: 20, max: 100)
#   - categoryId: string (VK album ID)
#   - search: string
#   - sortBy: 'date' | 'price_asc' | 'price_desc' | 'popular'
#   - priceFrom: number (in rubles)
#   - priceTo: number (in rubles)
#   - fresh: boolean (bypass cache)
#
# Example API calls:
#   curl http://localhost:3000/api/vk/products
#   curl http://localhost:3000/api/vk/products?search=gaming&sortBy=price_asc
#   curl http://localhost:3000/api/vk/categories
#   curl -X POST -H "X-API-Key: $SYNC_API_KEY" http://localhost:3000/api/vk/sync
#
# ============================================================================
